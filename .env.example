# ========================================================
# AI INTERVIEW PREPARATION PLATFORM - MASTER CONFIG TEMPLATE
# ========================================================

# --- DATABASE (MongoDB Atlas or Local) ---
# Replace with your Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/interview_platform?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/interview_platform

# --- AUTHENTICATION & SECURITY ---
JWT_SECRET=InterviewPlatformSuperSecretKeyForJWTAuthentication2026SecureKeyWithAtLeast256BitsLongForHmacSha256Security
JWT_EXPIRATION_MS=86400000

# --- GOOGLE GEMINI AI ---
# Get an API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# --- MICROSERVICES NETWORKING ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_MOCKS=false

# --- EMAIL / SMTP NOTIFICATIONS (OPTIONAL FOR REAL OTP / RESET EMAILS) ---
# If using Gmail, generate an App Password from: https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@aiinterviewprep.com
