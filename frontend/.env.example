# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================

# Backend API Base URL
# - In development: Leave empty to route requests through the Vite dev server proxy
#   (/api -> http://localhost:8080). This avoids browser CORS restrictions completely.
# - Direct calls: Set to "http://localhost:8080" if calling directly (ensure port 3000 is running).
# - Production: Set to your production API domain (e.g. "https://api.yourdomain.com").
VITE_API_BASE_URL=

# Proxy target for Vite dev server (defaults to http://localhost:8080 if unset)
VITE_PROXY_TARGET=http://localhost:8080

# When true, mocks API responses without making any network calls
VITE_USE_MOCKS=false
