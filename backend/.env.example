# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Port
SERVER_PORT=8080

# MongoDB Atlas or Local Connection URI
# Local default: mongodb://localhost:27017/interview_platform
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/interview_platform?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/interview_platform

# JWT Authentication Secret (Must be 256-bit or longer string for HMAC-SHA256)
JWT_SECRET=InterviewPlatformSuperSecretKeyForJWTAuthentication2026SecureKeyWithAtLeast256BitsLongForHmacSha256Security
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Google Gemini API Key (Optional: for real multimodal AI evaluation)
GEMINI_API_KEY=

# Dedicated AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Email / SMTP Configuration (Optional: for real OTP & Password Reset emails)
# Set MAIL_ENABLED=true and provide your Gmail App Password to send real emails
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@aiinterviewprep.com
